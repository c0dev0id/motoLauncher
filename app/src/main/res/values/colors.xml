<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light theme (day). The dark theme overrides live in values-night/colors.xml;
         values only defined once here (accent + icon background) apply in both modes. -->
    <color name="background">#EEF1F5</color>
    <color name="surface">#D6DCE4</color>
    <color name="tile_default">#FFFFFF</color>
    <color name="tile_focused">#2F6FED</color>
    <color name="tile_pressed">#1E4FB0</color>
    <color name="on_surface">#14181D</color>
    <color name="on_surface_muted">#55606E</color>
    <!-- Unlit segments of the Wi-Fi / cellular meters. Deliberately far from on_surface:
         the lit bars must be readable at a glance, so "empty" has to recede while still
         showing where the missing bars would be. -->
    <color name="signal_track">#9AA5B4</color>
    <color name="ic_launcher_background">#0F1216</color>
</resources>
