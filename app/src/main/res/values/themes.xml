<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MotoLauncher" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <item name="colorPrimary">@color/tile_focused</item>
        <item name="colorOnPrimary">@color/on_surface</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.MotoLauncher.Dialog.Alert</item>
    </style>

    <!-- Dialog chrome lives here, not in code, so every dialog the app shows gets the
         launcher palette and a glove-sized minimum width. Theme.MotoLauncher.Dialog is
         for plain Dialog(context, theme); the overlay is what AlertDialog.Builder(context)
         picks up via alertDialogTheme, so callers never name a theme. -->
    <style name="Theme.MotoLauncher.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:windowMinWidthMajor">@dimen/dialog_min_width</item>
        <item name="android:windowMinWidthMinor">@dimen/dialog_min_width</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorPrimary">@color/tile_focused</item>
        <item name="colorOnPrimary">@color/on_surface</item>
    </style>

    <style name="ThemeOverlay.MotoLauncher.Dialog.Alert" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:windowMinWidthMajor">@dimen/dialog_min_width</item>
        <item name="android:windowMinWidthMinor">@dimen/dialog_min_width</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorPrimary">@color/tile_focused</item>
        <item name="colorOnPrimary">@color/on_surface</item>
    </style>

    <!-- Glove-sized header control; every button in a TouchOnlyRow header uses this so
         the minimum touch target is stated once. -->
    <style name="Widget.MotoLauncher.HeaderButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/header_button_margin_start</item>
        <item name="android:minHeight">@dimen/header_button_min_height</item>
    </style>

    <style name="Theme.MotoLauncher.NoTransition" parent="Theme.MotoLauncher">
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- One action row of the tile menu: a glove-sized tile-styled button. -->
    <style name="Widget.MotoLauncher.DialogAction" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/dialog_action_height</item>
        <item name="android:layout_marginTop">@dimen/dialog_action_margin_top</item>
        <item name="android:background">@drawable/tile_background</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">@dimen/text_dialog_action</item>
    </style>
</resources>
