<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="10dp">

    <de.codevoid.motolauncher.ui.TouchOnlyRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackground"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back"
            android:scaleType="center" />

        <EditText
            android:id="@+id/searchBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/tile_background"
            android:padding="16dp"
            android:hint="@string/search_hint"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/on_surface"
            android:textColorHint="@color/on_surface_muted"
            android:textSize="20sp"
            android:importantForAutofill="no" />

        <!-- Browse mode only; hidden as one group while picking an app for a slot. -->
        <Button
            android:id="@+id/settingsButton"
            style="@style/Widget.MotoLauncher.HeaderButton"
            android:text="@string/settings" />
    </de.codevoid.motolauncher.ui.TouchOnlyRow>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/appGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:focusable="false"
        android:descendantFocusability="afterDescendants" />
</LinearLayout>
