<?xml version="1.0" encoding="utf-8"?>
<de.codevoid.motolauncher.ui.TouchOnlyRow xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/dialog_padding">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/link_label_hint"
        android:textColor="@color/on_surface_muted"
        android:textSize="@dimen/text_dialog_field_label"
        android:paddingBottom="@dimen/dialog_field_label_padding_bottom" />

    <EditText
        android:id="@+id/linkLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="text"
        android:imeOptions="actionNext"
        android:nextFocusForward="@+id/linkUrl"
        android:textColor="@color/on_surface"
        android:backgroundTint="@color/tile_focused"
        android:padding="@dimen/dialog_field_padding"
        android:singleLine="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/link_url_hint"
        android:textColor="@color/on_surface_muted"
        android:textSize="@dimen/text_dialog_field_label"
        android:paddingTop="@dimen/dialog_field_gap"
        android:paddingBottom="@dimen/dialog_field_label_padding_bottom" />

    <EditText
        android:id="@+id/linkUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textUri"
        android:textColor="@color/on_surface"
        android:backgroundTint="@color/tile_focused"
        android:padding="@dimen/dialog_field_padding"
        android:singleLine="true" />

</de.codevoid.motolauncher.ui.TouchOnlyRow>
