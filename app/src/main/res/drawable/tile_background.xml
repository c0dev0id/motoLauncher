<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tile_pressed" />
            <corners android:radius="@dimen/tile_corner_radius" />
            <stroke android:width="@dimen/tile_stroke_pressed" android:color="@color/tile_focused" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tile_default" />
            <corners android:radius="@dimen/tile_corner_radius" />
            <stroke android:width="@dimen/tile_stroke_focused" android:color="@color/tile_focused" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tile_focused" />
            <corners android:radius="@dimen/tile_corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tile_default" />
            <corners android:radius="@dimen/tile_corner_radius" />
            <stroke android:width="@dimen/tile_stroke_default" android:color="@color/surface" />
        </shape>
    </item>
</selector>
