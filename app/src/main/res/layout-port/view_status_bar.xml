<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <!-- Row 1: time (left) and status indicators (right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/timeText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/michroma"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_status_clock"
            android:maxLines="1"
            tools:text="12:34" />

        <ImageView
            android:id="@+id/wifiIcon"
            android:layout_width="@dimen/status_icon_size"
            android:layout_height="@dimen/status_icon_size"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="@dimen/status_icon_margin"
            android:contentDescription="@null"
            android:src="@drawable/ic_wifi"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/cellularIcon"
            android:layout_width="@dimen/status_icon_size"
            android:layout_height="@dimen/status_icon_size"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="@dimen/status_icon_margin"
            android:contentDescription="@null"
            android:src="@drawable/ic_cellular"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/batteryIcon"
            android:layout_width="@dimen/status_icon_size"
            android:layout_height="@dimen/status_icon_size"
            android:layout_gravity="center_vertical"
            android:contentDescription="@null"
            android:src="@drawable/ic_battery" />

        <TextView
            android:id="@+id/batteryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/status_battery_margin"
            android:fontFamily="@font/michroma"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/text_status_battery"
            android:maxLines="1"
            tools:text="87%" />
    </LinearLayout>

    <!-- Row 2: speed (centered) -->
    <TextView
        android:id="@+id/speedText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:fontFamily="@font/michroma"
        android:textColor="@color/on_surface"
        android:textSize="@dimen/text_status_clock"
        android:maxLines="1"
        android:visibility="gone"
        tools:text="87 km/h" />
</merge>
